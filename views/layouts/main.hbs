<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}} | {{appName}}</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <div class="app-shell">
      {{> sidebar}}
      <div class="app-main">
        <header class="topbar">
          <button class="menu-toggle" type="button" data-menu-toggle aria-label="Abrir menú">
            ☰
          </button>
          <div>
            <h1>{{title}}</h1>
            <p class="topbar-subtitle">Sistema de gestión administrativa</p>
          </div>
        </header>
        <main class="content">
          {{{body}}}
        </main>
        <footer class="app-footer">
          {{appName}} · {{year}} · Primera versión
        </footer>
      </div>
    </div>
    <div class="sidebar-backdrop" data-menu-close></div>
    <script src="/js/app.js"></script>
  </body>
</html>
